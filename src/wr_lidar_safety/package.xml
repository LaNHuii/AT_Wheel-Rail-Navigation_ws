  <version>0.1.0</version>
  <description>Conservative MID-360S point-cloud safety zones.</description>
  <maintainer email="maintainer@example.com">AT Wheel-Rail Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
