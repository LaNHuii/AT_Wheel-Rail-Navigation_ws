<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_rail_chassis">
  <xacro:include filename="$(find wr_description)/urdf/wr_chassis.urdf.xacro"/>

  <!--
    Replaceable ros2_control boundary for stage 4.3. The navigation-side command
    and state interfaces stay unchanged when this mock hardware is later
    replaced by GazeboSystem or the real electrical-control adapter.
  -->
  <ros2_control name="WheelRailMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>

    <xacro:macro name="mock_swerve_interfaces" params="prefix">
      <joint name="${prefix}_steering_joint">
        <command_interface name="position">
          <param name="min">-1.745329252</param>
          <param name="max">1.745329252</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:mock_swerve_interfaces prefix="front_left"/>
    <xacro:mock_swerve_interfaces prefix="front_right"/>
    <xacro:mock_swerve_interfaces prefix="rear_right"/>
    <xacro:mock_swerve_interfaces prefix="rear_left"/>
  </ros2_control>
</robot>
