<?xml version="1.0"?>
<package format="3">
  <name>wr_rail_controller</name>
  <version>0.1.0</version>
  <description>Replaceable rail clamp and rail-mode simulation controller.</description>
  <maintainer email="maintainer@example.com">AT Wheel-Rail Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>wr_interfaces</depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
