<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_rail_chassis">
  <xacro:include filename="$(find wr_description)/urdf/wr_chassis.urdf.xacro"/>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <xacro:macro name="gazebo_swerve_interfaces" params="prefix">
      <joint name="${prefix}_steering_joint">
        <command_interface name="position">
          <param name="min">-2.88</param>
          <param name="max">2.88</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:gazebo_swerve_interfaces prefix="front_left"/>
    <xacro:gazebo_swerve_interfaces prefix="front_right"/>
    <xacro:gazebo_swerve_interfaces prefix="rear_right"/>
    <xacro:gazebo_swerve_interfaces prefix="rear_left"/>
  </ros2_control>

  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
    <gravity>true</gravity>
  </gazebo>

  <xacro:macro name="gazebo_wheel_contact" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>
  <xacro:gazebo_wheel_contact prefix="front_left"/>
  <xacro:gazebo_wheel_contact prefix="front_right"/>
  <xacro:gazebo_wheel_contact prefix="rear_right"/>
  <xacro:gazebo_wheel_contact prefix="rear_left"/>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find wr_gazebo)/config/gazebo_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
