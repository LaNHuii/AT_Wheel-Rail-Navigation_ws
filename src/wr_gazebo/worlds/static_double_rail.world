<?xml version="1.0"?>
<sdf version="1.6">
  <world name="static_double_rail">
    <gravity>0 0 -9.80665</gravity>
    <physics name="ode_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.08</contact_max_correcting_vel><contact_surface_layer>0.0005</contact_surface_layer></constraints>
      </ode>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.88 0.94 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="concrete_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>12 6 0.10</size></box></geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>12 6 0.10</size></box></geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.62 0.62 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="left_rail">
      <static>true</static>
      <pose>0 0.30 0.035 0 1.57079632679 0</pose>
      <link name="rail_link">
        <collision name="rail_collision">
          <geometry><cylinder><radius>0.025</radius><length>8.0</length></cylinder></geometry>
          <surface><friction><ode><mu>0.60</mu><mu2>0.60</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_visual">
          <geometry><cylinder><radius>0.025</radius><length>8.0</length></cylinder></geometry>
          <material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="right_rail">
      <static>true</static>
      <pose>0 -0.30 0.035 0 1.57079632679 0</pose>
      <link name="rail_link">
        <collision name="rail_collision">
          <geometry><cylinder><radius>0.025</radius><length>8.0</length></cylinder></geometry>
          <surface><friction><ode><mu>0.60</mu><mu2>0.60</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_visual">
          <geometry><cylinder><radius>0.025</radius><length>8.0</length></cylinder></geometry>
          <material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
        </visual>
      </link>
    </model>

    <include><uri>model://sun</uri></include>
  </world>
</sdf>
