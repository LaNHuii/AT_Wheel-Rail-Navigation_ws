<?xml version="1.0"?>
<sdf version="1.6">
  <world name="u_rail_entry">
    <gravity>0 0 -9.80665</gravity>
    <physics name="ode_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver><constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.08</contact_max_correcting_vel><contact_surface_layer>0.0005</contact_surface_layer></constraints></ode>
    </physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>50.0</update_rate></plugin>
    <model name="concrete_floor"><static>true</static><link name="floor_link">
      <collision name="floor_collision"><geometry><box><size>12 6 0.10</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="floor_visual"><geometry><box><size>12 6 0.10</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.62 0.62 0.58 1</diffuse></material></visual>
    </link></model>
    <model name="left_rail"><static>true</static><pose>1.5 0.30 0.025 0 1.57079632679 0</pose><link name="rail_link">
      <collision name="rail_collision"><geometry><cylinder><radius>0.025</radius><length>5.0</length></cylinder></geometry><surface><friction><ode><mu>0.60</mu><mu2>20.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="rail_visual"><geometry><cylinder><radius>0.025</radius><length>5.0</length></cylinder></geometry><material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual>
    </link></model>
    <model name="right_rail"><static>true</static><pose>1.5 -0.30 0.025 0 1.57079632679 0</pose><link name="rail_link">
      <collision name="rail_collision"><geometry><cylinder><radius>0.025</radius><length>5.0</length></cylinder></geometry><surface><friction><ode><mu>0.60</mu><mu2>20.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="rail_visual"><geometry><cylinder><radius>0.025</radius><length>5.0</length></cylinder></geometry><material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual>
    </link></model>
    <!-- 实物图片中两根轨道在入口由同一根管道闭合。直横管是偏保守的碰撞近似，圆角 U 形端部留待后续视觉和机械精化。 -->
    <model name="u_end_cross_pipe"><static>true</static><pose>-1.0 0 0.025 1.57079632679 0 0</pose><link name="rail_link">
      <collision name="rail_collision"><geometry><cylinder><radius>0.025</radius><length>0.60</length></cylinder></geometry><surface><friction><ode><mu>0.60</mu><mu2>20.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="rail_visual"><geometry><cylinder><radius>0.025</radius><length>0.60</length></cylinder></geometry><material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual>
    </link></model>
    <include><uri>model://sun</uri></include>
  </world>
</sdf>
